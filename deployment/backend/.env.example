# ============================================================
# RAO Backend .env — PRZYKŁAD dla produkcji
# Skopiuj jako .env i uzupełnij prawdziwymi wartościami
# ============================================================

# --- Baza danych ---
# Format: mysql+aiomysql://USER:PASSWORD@HOST:PORT/DATABASE
RAO_DATABASE_URL=mysql+aiomysql://ts123_rao_user:TWOJE_HASLO@localhost:3306/ts123_rao

# --- Bezpieczeństwo ---
# Wygeneruj: python -c "import secrets; print(secrets.token_hex(32))"
RAO_SECRET_KEY=wygeneruj-losowy-klucz-min-64-znaki-hex
RAO_ACCESS_TOKEN_EXPIRE_MINUTES=480
RAO_ENV=production

# --- CORS (frontend) ---
# Lista dozwolonych originów (JSON array)
RAO_CORS_ORIGINS=["https://www.toolsmart.pl","https://toolsmart.pl"]

# --- Frontend URL (do linków w emailach) ---
RAO_FRONTEND_URL=https://www.toolsmart.pl/rao

# --- SMTP (email) ---
RAO_SMTP_HOST=mail.toolsmart.pl
RAO_SMTP_PORT=587
RAO_SMTP_USER=noreply@toolsmart.pl
RAO_SMTP_PASSWORD=TWOJE_HASLO_POCZTY
RAO_SMTP_FROM=noreply@toolsmart.pl
RAO_SMTP_TLS=True

# --- PDF renderer ---
# "weasyprint" (zalecane na Linux) lub "playwright" (wymaga Chromium)
RAO_PDF_RENDERER=weasyprint

# --- GUS API (dane firm z REGON) ---
RAO_GUS_API_KEY=twoj_klucz_gus_lub_pusty

# --- Fakturownia (FA integration) ---
# UWAGE: W dumpie bazy FA settings są już zapisane (enabled=1, domain=matsnd).
# Te zmienne służą tylko do bootstrapu gdyby tabelka była pusta.
# enc_key MUSI być ten sam co na lokalnym środowisku (inny klucz = nie odszyfrujesz tokena).
RAO_FAKTUROWNIA_ENC_KEY=twoj_klucz_szyfrowania_tokena
RAO_FAKTUROWNIA_API_TOKEN=twoj_token_fakturownia
RAO_FAKTUROWNIA_DOMAIN_SUBDOMAIN=matsnd

# --- Nominatim (geokodowanie adresów) ---
RAO_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
