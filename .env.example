# ============================================================
# RAO — szablon zmiennych środowiskowych
# Skopiuj do .env i dostosuj wartości:
#   cp .env.example .env
# .env jest w .gitignore — NIGDY nie commituj prawdziwych sekretów.
# ============================================================

# === DATABASE ===
RAO_DATABASE_URL=mysql+aiomysql://rao_user:<<DB_PASSWORD_PLACEHOLDER>>@localhost:3306/rao_new
RAO_DB_USER=rao_user
RAO_DB_PASSWORD=<<DB_PASSWORD_PLACEHOLDER>>
RAO_DB_NAME=rao_new
RAO_DB_HOST=localhost
RAO_DB_PORT=3306

# === AUTH ===
# WYMIEŃ na produkcji — minimum 32 znaki, najlepiej `openssl rand -hex 32`
RAO_SECRET_KEY=super-secret-jwt-key-change-in-production-min-32-chars-rao2026
RAO_ACCESS_TOKEN_EXPIRE_MINUTES=480

# === SMTP (DEV → Mailpit, PROD → prawdziwy SMTP) ===
RAO_SMTP_HOST=localhost
RAO_SMTP_PORT=1025
RAO_SMTP_USER=
RAO_SMTP_PASSWORD=
RAO_SMTP_FROM=noreply@rao-app.pl
RAO_SMTP_TLS=false
RAO_FRONTEND_URL=http://localhost:5173

# === INTEGRATIONS ===
# GUS API key — uzyskaj na https://api.stat.gov.pl/Home/RegonApi (zostaw puste w dev — używa testowego)
RAO_GUS_API_KEY=
# Nominatim (OpenStreetMap reverse geocoding) — domyślny publiczny serwer
RAO_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Fakturownia API (MVP dla spike — read-only display faktur)
# RAO-P2-012: Fakturownia integration (real implementation — replaces spike env vars)
# Fernet encryption key for API token at rest — generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: changing this key invalidates stored tokens (need to re-enter in settings)
RAO_FAKTUROWNIA_ENC_KEY=<<generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">>
# Legacy spike vars (no longer used — token stored encrypted in DB)
# FAKTUROWNIA_API_TOKEN=
# FAKTUROWNIA_DOMAIN_URL=toolsmart

# === CORS ===
# Lista origins frontendu (JSON array). Dodaj prod URL przy deployu.
RAO_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# === MCP VISION (opcjonalne) ===
# Klucz Anthropic API dla lokalnego MCP serwera vision (mcp-vision/)
# Uzyskaj na: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# === MCP SERVERS (opcjonalne) ===
# GitHub Personal Access Token dla MCP github server
# Uzyskaj na: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Brave Search API Key dla MCP brave-search server
# Uzyskaj na: https://api.search.brave.com/app/keys
BRAVE_API_KEY=
