# ============================================================
# RAO — szablon zmiennych środowiskowych
# Skopiuj do .env i dostosuj wartości:
#   cp .env.example .env
# .env jest w .gitignore — NIGDY nie commituj prawdziwych sekretów.
# ============================================================

# === DATABASE ===
RAO_DATABASE_URL=mysql+aiomysql://rao_user:RaoPass2026!@localhost:3306/rao_new
RAO_DB_USER=rao_user
RAO_DB_PASSWORD=RaoPass2026!
RAO_DB_NAME=rao_new
RAO_DB_HOST=localhost
RAO_DB_PORT=3306

# === AUTH ===
# WYMIEŃ na produkcji — minimum 32 znaki, najlepiej `openssl rand -hex 32`
RAO_SECRET_KEY=super-secret-jwt-key-change-in-production-min-32-chars-rao2026
RAO_ACCESS_TOKEN_EXPIRE_MINUTES=480

# === SMTP (DEV → Mailpit, PROD → prawdziwy SMTP) ===
RAO_SMTP_HOST=localhost
RAO_SMTP_PORT=1025
RAO_SMTP_USER=
RAO_SMTP_PASSWORD=
RAO_SMTP_FROM=noreply@rao-app.pl
RAO_SMTP_TLS=false
RAO_FRONTEND_URL=http://localhost:5173

# === INTEGRATIONS ===
# GUS API key — uzyskaj na https://api.stat.gov.pl/Home/RegonApi (zostaw puste w dev — używa testowego)
RAO_GUS_API_KEY=
# Nominatim (OpenStreetMap reverse geocoding) — domyślny publiczny serwer
RAO_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# === CORS ===
# Lista origins frontendu (JSON array). Dodaj prod URL przy deployu.
RAO_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# === MCP VISION (opcjonalne) ===
# Klucz Anthropic API dla lokalnego MCP serwera vision (mcp-vision/)
# Uzyskaj na: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
